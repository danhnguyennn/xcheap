# Copy this file to .env and fill in real values before running the server.
# .env itself is gitignored — never commit real secrets.

# Port the server listens on. Optional — defaults to 3434 if unset.
PORT=3434

# MongoDB connection.
# - Local (plain `npm run dev`, no Docker): mongodb://127.0.0.1:27017
# - docker compose, using the bundled "mongo" service: mongodb://mongo:27017
# - External/managed database (e.g. MongoDB Atlas): paste its real
#   connection string here instead — nothing else needs to change.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=xscr_store_db

# Signs the login session cookie — must be a long random string in any real
# deployment. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudflare Turnstile (bot/spam protection on login & register).
# Get real keys from https://dash.cloudflare.com -> Turnstile -> Add widget.
# Leave blank to fall back to Cloudflare's public test keys (always pass —
# fine for local dev, not real protection).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Tunnel (only needed if using docker-compose's "cloudflared"
# service to expose the app publicly without opening any inbound port on
# the VPS). Get it from: Cloudflare dashboard -> Zero Trust -> Networks ->
# Tunnels -> Create a tunnel -> Docker connector -> copy the token shown.
CLOUDFLARE_TUNNEL_TOKEN=
